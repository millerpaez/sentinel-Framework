<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- data-provider-thread-count: how many scenarios run at the same time -->
<suite name="Sentinel" data-provider-thread-count="3">
    <test name="Cucumber scenarios">
        <classes>
            <class name="com.miller.sentinel.runners.RunCucumberTest"/>
        </classes>
    </test>
</suite>
