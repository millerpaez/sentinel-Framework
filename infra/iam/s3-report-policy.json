{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListReportBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sentinel-reports-millerpaez"
    },
    {
      "Sid": "UploadReportsUnderRuns",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::sentinel-reports-millerpaez/runs/*"
    }
  ]
}
